<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>IRCTCTatkalBot</AssemblyName>
    <RootNamespace>IRCTCTatkalBot</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Selenium WebDriver for browser automation -->
    <!-- Selenium Manager (built into 4.6+) downloads a ChromeDriver that matches the installed Chrome; avoid pinning an old driver EXE next to the app. -->
    <PackageReference Include="Selenium.WebDriver" Version="4.27.0" />
    <!-- JSON serialization for settings & accounts -->
    <PackageReference Include="System.Text.Json"             Version="9.0.7" />
  </ItemGroup>

</Project>
