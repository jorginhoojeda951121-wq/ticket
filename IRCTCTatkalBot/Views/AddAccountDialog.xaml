<Window x:Class="IRCTCTatkalBot.Views.AddAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add IRCTC Account"
        Width="450"
        SizeToContent="Height"
        MinHeight="260"
        Background="#1E1E2E" Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        UseLayoutRounding="True">

    <!-- Dock buttons last so they keep full height; fixed Height was clipping MinHeight 38 + padding -->
    <DockPanel Margin="20" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,2">
            <Button Content="Cancel" Style="{StaticResource SecondaryBtn}"
                    MinWidth="108" Margin="0,0,10,0"
                    Click="CancelBtn_Click"/>
            <Button Content="Add Account" Style="{StaticResource PrimaryBtn}"
                    MinWidth="120"
                    Click="AddBtn_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Add IRCTC Account" FontSize="16" FontWeight="Bold"
                       Foreground="#4A90D9" Margin="0,0,0,16"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                <StackPanel>
                    <TextBlock Text="IRCTC Username" Foreground="#CCCCDD" Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameBox" Height="30" Background="#12121E"
                             Foreground="White" BorderBrush="#4A4A6A" Padding="6,4" FontSize="13"/>

                    <TextBlock Text="Password" Foreground="#CCCCDD" Margin="0,12,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Height="30" Background="#12121E"
                                 Foreground="White" BorderBrush="#4A4A6A" Padding="6,4" FontSize="13"/>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </DockPanel>
</Window>
