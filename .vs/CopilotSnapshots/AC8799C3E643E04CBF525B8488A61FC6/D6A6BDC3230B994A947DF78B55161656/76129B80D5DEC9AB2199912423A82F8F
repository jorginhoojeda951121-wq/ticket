    /// <summary>Helper for formatting error diagnostics</summary>
    public static class DriverDiagnostics
    {
        public static string FormatShort(Exception ex)
        {
            if (ex is WebDriverTimeoutException)
                return "Timeout (element not found/ready)";
            if (ex is NoSuchElementException)
                return "Element not found";
            if (ex is StaleElementReferenceException)
                return "Element became stale";
            return ex.GetType().Name;
        }
    }
