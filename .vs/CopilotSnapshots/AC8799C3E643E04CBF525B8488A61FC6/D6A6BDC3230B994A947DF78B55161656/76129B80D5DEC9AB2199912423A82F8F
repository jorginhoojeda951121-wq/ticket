        private BookingResult Fail(string reason)
        {
            _result.Status = BookingStatus.Failed;
            _result.ErrorMessage = reason;
            _result.CompletedAt = DateTime.Now;
            Logger.Error($"BookingEngine: FAILED – {reason}");
            OnStatusChanged?.Invoke(_result);
            return _result;
        }

        private void UpdateStatus(BookingStatus status)
        {
            _result.Status = status;
            Logger.Info($"BookingEngine: → {status}");
            OnStatusChanged?.Invoke(_result);
        }

        // ── Helper Methods for Train Selection ─────────────────────────

        private IWebElement? PickTrainCard(IReadOnlyCollection<IWebElement> cards, string? trainNumber)
        {
            if (cards.Count == 0) return null;
            if (string.IsNullOrWhiteSpace(trainNumber)) return cards.FirstOrDefault();

            foreach (var card in cards)
            {
                try
                {
                    string text = card.Text ?? "";
                    if (text.Contains(trainNumber, StringComparison.OrdinalIgnoreCase))
                        return card;
                }
                catch { }
            }

            return cards.FirstOrDefault();
        }

        private IWebElement? FindFirstClickableIn(IWebElement container, params By[] locators)
        {
            foreach (var by in locators)
            {
                try
                {
                    var els = container.FindElements(by);
                    foreach (var el in els)
                    {
                        if (el.Displayed && el.Enabled)
                            return el;
                    }
                }
                catch { }
            }
            return null;
        }

        private IWebElement? FindFirstClickableGlobal(params By[] locators)
        {
            foreach (var by in locators)
            {
                try
                {
                    var els = Driver.FindElements(by);
                    foreach (var el in els)
                    {
                        if (el.Displayed && el.Enabled)
                            return el;
                    }
                }
                catch { }
            }
            return null;
        }

