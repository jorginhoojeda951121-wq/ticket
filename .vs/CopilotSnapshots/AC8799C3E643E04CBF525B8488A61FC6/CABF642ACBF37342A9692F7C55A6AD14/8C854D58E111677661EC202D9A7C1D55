<Window x:Class="IRCTCTatkalBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IRCTC Tatkal Bot" Height="750" Width="1100"
        Background="#1E1E2E" Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Dark theme colours -->
        <SolidColorBrush x:Key="PanelBg"      Color="#2A2A3E"/>
        <SolidColorBrush x:Key="AccentBlue"   Color="#4A90D9"/>
        <SolidColorBrush x:Key="AccentGreen"  Color="#50FA7B"/>
        <SolidColorBrush x:Key="AccentRed"    Color="#FF5555"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#888899"/>

        <!-- Reusable label style -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,8,0,2"/>
        </Style>

        <!-- Input box style -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background"  Value="#12121E"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="Padding"     Value="6,4"/>
            <Setter Property="Height"      Value="30"/>
            <Setter Property="FontSize"    Value="13"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"  Value="#4A90D9"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Padding"     Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="FontSize"    Value="13"/>
        </Style>

        <!-- Danger button -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#FF5555"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL ═══════════════════════════════════════════ -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">

            <!-- App Title -->
            <TextBlock Text="🚂 IRCTC Tatkal Bot"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource AccentBlue}"
                       Margin="0,0,0,16"/>

            <!-- ── Accounts Section ── -->
            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="ACCOUNTS" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    <ListView x:Name="AccountsList"
                              ItemsSource="{Binding Accounts}"
                              Background="Transparent" BorderThickness="0"
                              Height="140" Margin="0,6,0,6"
                              Foreground="White" FontSize="12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                    <TextBlock Text=" — " Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding Username}" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Content="+ Add Account" Style="{StaticResource PrimaryBtn}"
                            Height="28" Click="AddAccountBtn_Click"/>
                </StackPanel>
            </Border>

            <!-- ── Train Config Section ── -->
            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="TRAIN CONFIG" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11"/>

                    <TextBlock Text="From Station" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding FromStation, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}"/>

                    <TextBlock Text="To Station" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding ToStation, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}"/>

                    <TextBlock Text="Journey Date" Style="{StaticResource Label}"/>
                    <DatePicker x:Name="JourneyDatePicker"
                                SelectedDate="{Binding JourneyDate}"
                                Background="#12121E" Foreground="White" Height="30"/>

                    <TextBlock Text="Train Number (optional)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding TrainNumber, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}"/>

                    <TextBlock Text="Class" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="ClassCombo"
                              SelectedValue="{Binding TrainClass}"
                              Background="#12121E" Foreground="White" Height="30"
                              SelectionChanged="ClassCombo_SelectionChanged">
                        <ComboBoxItem Content="SL"/>
                        <ComboBoxItem Content="3A" IsSelected="True"/>
                        <ComboBoxItem Content="2A"/>
                        <ComboBoxItem Content="1A"/>
                        <ComboBoxItem Content="CC"/>
                        <ComboBoxItem Content="2S"/>
                    </ComboBox>

                    <TextBlock Text="UPI ID" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding UpiId, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}" x:Name="UpiIdBox"/>
                </StackPanel>
            </Border>

            <!-- ── Settings Section ── -->
            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="SETTINGS" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    <TextBlock Text="2Captcha API Key" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding CaptchaApiKey, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Input}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══ RIGHT PANEL ══════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <!-- ── Top Controls ── -->
            <Border Grid.Row="0" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13" Foreground="{StaticResource TextMuted}">
                            Tatkal window: <Run Foreground="{StaticResource AccentBlue}"
                                                Text="{Binding WindowTimeDisplay}"/>
                        </TextBlock>
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="White"
                                   Text="{Binding CountdownText}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="▶  Start (Scheduled)"
                            Style="{StaticResource PrimaryBtn}"
                            Margin="8,0" IsEnabled="{Binding CanStart}"
                            Click="StartScheduledBtn_Click"/>

                    <Button Grid.Column="2" Content="⚡ Start Now"
                            Style="{StaticResource PrimaryBtn}"
                            Background="#9B59B6" Margin="0,0,8,0"
                            IsEnabled="{Binding CanStart}"
                            Click="StartNowBtn_Click"/>

                    <Button Grid.Column="3" Content="⏹ Stop"
                            Style="{StaticResource DangerBtn}"
                            IsEnabled="{Binding IsRunning}"
                            Click="StopBtn_Click"/>
                </Grid>
            </Border>

            <!-- ── Results Table ── -->
            <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="BOOKING RESULTS" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Results}"
                              AutoGenerateColumns="False"
                              Background="Transparent"
                              Foreground="White"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowBackground="#1A1A2E"
                              AlternatingRowBackground="#22223A"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account"   Binding="{Binding AccountId}" Width="120"/>
                            <DataGridTextColumn Header="Status"    Binding="{Binding Status}"    Width="120"/>
                            <DataGridTextColumn Header="PNR"       Binding="{Binding PnrNumber}" Width="120"/>
                            <DataGridTextColumn Header="Elapsed"   Binding="{Binding ElapsedSeconds, StringFormat={}{0:F1}s}" Width="80"/>
                            <DataGridTextColumn Header="Error"     Binding="{Binding ErrorMessage}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ── Live Log ── -->
            <Border Grid.Row="2" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="LIVE LOG" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding Logs}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#AAFFAA"
                             FontFamily="Consolas"
                             FontSize="11"
                             Height="150"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
