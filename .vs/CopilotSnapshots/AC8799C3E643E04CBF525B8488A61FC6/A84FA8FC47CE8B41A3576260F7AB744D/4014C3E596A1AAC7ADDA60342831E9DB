<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>IRCTCTatkalBot</AssemblyName>
    <RootNamespace>IRCTCTatkalBot</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <ApplicationIcon>tatkal.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Selenium WebDriver for browser automation -->
    <PackageReference Include="Selenium.WebDriver"           Version="4.18.1" />
    <!-- Auto-downloads matching ChromeDriver -->
    <PackageReference Include="Selenium.WebDriver.ChromeDriver" Version="123.0.6312.8600" />
    <!-- JSON serialization for settings & accounts -->
    <PackageReference Include="System.Text.Json"             Version="8.0.4" />
  </ItemGroup>

</Project>
