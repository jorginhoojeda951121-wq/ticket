<Window x:Class="IRCTCTatkalBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IRCTC Tatkal Bot" Height="900" Width="1200"
        Background="#1E1E2E" Foreground="White"
        WindowStartupLocation="CenterScreen"
        MinHeight="700" MinWidth="900"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Dark theme colours -->
        <SolidColorBrush x:Key="PanelBg"      Color="#2A2A3E"/>
        <SolidColorBrush x:Key="AccentBlue"   Color="#4A90D9"/>
        <SolidColorBrush x:Key="AccentGreen"  Color="#50FA7B"/>
        <SolidColorBrush x:Key="AccentRed"    Color="#FF5555"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#888899"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#12121E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4A90D9"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>

        <!-- Reusable label style -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,8,0,2"/>
        </Style>

        <!-- Input box style -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background"  Value="#12121E"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="Padding"     Value="8,5"/>
            <Setter Property="MinHeight"   Value="34"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DatePicker style -->
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="#12121E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <Setter Property="Background" Value="#1F2233"/>
                        <Setter Property="Foreground" Value="#EAF2FF"/>
                        <Setter Property="BorderBrush" Value="#4A4A6A"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="CalendarDayButtonStyle">
                            <Setter.Value>
                                <Style TargetType="CalendarDayButton">
                                    <Setter Property="Foreground" Value="#EAF2FF"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsInactive" Value="True">
                                            <Setter Property="Foreground" Value="#7F89A8"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#303651"/>
                                        </Trigger>
                                        <Trigger Property="IsToday" Value="True">
                                            <Setter Property="BorderBrush" Value="#4A90D9"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#4A90D9"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="CalendarButtonStyle">
                            <Setter.Value>
                                <Style TargetType="CalendarButton">
                                    <Setter Property="Foreground" Value="#EAF2FF"/>
                                    <Setter Property="Background" Value="#252A3D"/>
                                    <Setter Property="BorderBrush" Value="#3A3A56"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#303651"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="#12121E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- ComboBox style - Dark mode without custom template -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#12121E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#5A6A8A"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4A90D9"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter Property="BorderBrush" Value="#4A90D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBoxItem style - Dark mode for dropdown items -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2A3A5E"/>
                    <Setter Property="Foreground" Value="#7ABAFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0A0A12"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3A5E"/>
                    <Setter Property="Foreground" Value="#7ABAFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Header style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#4A90D9"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- DataGrid Cell style -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"  Value="#4A90D9"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Padding"     Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="MinHeight"   Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Danger button -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#FF5555"/>
        </Style>

        <!-- ScrollViewer style -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ScrollBar style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#4A4A6A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL ═══════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="0" Margin="0,0,12,0" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

            <!-- App Title -->
            <TextBlock Text="🚂 IRCTC Tatkal Bot"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource AccentBlue}"
                       Margin="0,0,0,16"/>

            <!-- ── Accounts Section ── -->
            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="ACCOUNTS" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    <ListView x:Name="AccountsList"
                              ItemsSource="{Binding Accounts}"
                              Background="Transparent" BorderThickness="0"
                              Height="140" Margin="0,6,0,6"
                              Foreground="White" FontSize="12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                    <TextBlock Text=" — " Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding Username}" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Content="+ Add Account" Style="{StaticResource PrimaryBtn}"
                            Click="AddAccountBtn_Click"/>
                </StackPanel>
            </Border>

            <!-- ── Train Config Section ── -->
            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="TRAIN CONFIG" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11"/>

                    <TextBlock Text="From Station" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding FromStation, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}"/>

                    <TextBlock Text="To Station" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding ToStation, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}"/>

                    <TextBlock Text="Journey Date" Style="{StaticResource Label}"/>
                    <DatePicker x:Name="JourneyDatePicker"
                                SelectedDate="{Binding JourneyDate}"
                                Style="{StaticResource DatePickerStyle}"/>

                    <TextBlock Text="Train Number (optional)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding TrainNumber, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}"/>

                    <TextBlock Text="Class" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="ClassCombo"
                              SelectedValue="{Binding TrainClass}"
                              Style="{StaticResource ComboBoxStyle}"
                              SelectionChanged="ClassCombo_SelectionChanged">
                        <ComboBoxItem Content="SL"/>
                        <ComboBoxItem Content="3A" IsSelected="True"/>
                        <ComboBoxItem Content="2A"/>
                        <ComboBoxItem Content="1A"/>
                        <ComboBoxItem Content="CC"/>
                        <ComboBoxItem Content="2S"/>
                    </ComboBox>

                    <TextBlock Text="UPI ID" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding UpiId, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}" x:Name="UpiIdBox"/>
                </StackPanel>
            </Border>

            <!-- ── Settings Section ── -->
            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="SETTINGS" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    <TextBlock Text="2Captcha API Key" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding CaptchaApiKey, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Input}"/>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ RIGHT PANEL ══════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <!-- ── Top Controls ── -->
            <Border Grid.Row="0" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13" Foreground="{StaticResource TextMuted}">
                            Tatkal window: <Run Foreground="{StaticResource AccentBlue}"
                                                Text="{Binding WindowTimeDisplay}"/>
                        </TextBlock>
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="White"
                                   Text="{Binding CountdownText}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="▶  Start (Scheduled)"
                            Style="{StaticResource PrimaryBtn}"
                            Margin="8,0" IsEnabled="{Binding CanStart}"
                            Click="StartScheduledBtn_Click"/>

                    <Button Grid.Column="2" Content="⚡ Start Now"
                            Style="{StaticResource PrimaryBtn}"
                            Background="#9B59B6" Margin="0,0,8,0"
                            IsEnabled="{Binding CanStart}"
                            Click="StartNowBtn_Click"/>

                    <Button Grid.Column="3" Content="⏹ Stop"
                            Style="{StaticResource DangerBtn}"
                            IsEnabled="{Binding IsRunning}"
                            Click="StopBtn_Click"/>
                </Grid>
            </Border>

            <!-- ── Results Table ── -->
            <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="BOOKING RESULTS" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Results}"
                              AutoGenerateColumns="False"
                              Background="#1A1A2E"
                              Foreground="White"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowBackground="#1A1A2E"
                              AlternatingRowBackground="#22223A"
                              BorderThickness="1"
                              BorderBrush="#4A4A6A"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account"   Binding="{Binding AccountId}" Width="100"/>
                            <DataGridTextColumn Header="Status"    Binding="{Binding Status}"    Width="100"/>
                            <DataGridTextColumn Header="PNR"       Binding="{Binding PnrNumber}" Width="100"/>
                            <DataGridTextColumn Header="Elapsed"   Binding="{Binding ElapsedSeconds, StringFormat={}{0:F1}s}" Width="80"/>
                            <DataGridTextColumn Header="Error"     Binding="{Binding ErrorMessage}" Width="*" MinWidth="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ── Live Log ── -->
            <Border Grid.Row="2" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="LIVE LOG" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding Logs}"
                             Background="#1A1A2E"
                             BorderBrush="#4A4A6A"
                             BorderThickness="1"
                             Foreground="#AAFFAA"
                             FontFamily="Consolas"
                             FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
