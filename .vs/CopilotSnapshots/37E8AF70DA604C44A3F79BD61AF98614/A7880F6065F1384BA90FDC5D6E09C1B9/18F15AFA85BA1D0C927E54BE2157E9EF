<Window x:Class="IRCTCTatkalBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IRCTC Tatkal Bot" Height="900" Width="1200"
        Background="#1E1E2E" Foreground="White"
        WindowStartupLocation="CenterScreen"
        MinHeight="700" MinWidth="900"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Dark theme colours -->
        <SolidColorBrush x:Key="PanelBg"      Color="#2A2A3E"/>
        <SolidColorBrush x:Key="AccentBlue"   Color="#4A90D9"/>
        <SolidColorBrush x:Key="AccentGreen"  Color="#50FA7B"/>
        <SolidColorBrush x:Key="AccentRed"    Color="#FF5555"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#888899"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#12121E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4A90D9"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
        <!-- Calendar theme templates resolve these system keys directly -->
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#F2F5FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#D7DDF7"/>
        <Color x:Key="{x:Static SystemColors.ActiveCaptionTextColorKey}">#FFFFFFFF</Color>
        <Color x:Key="{x:Static SystemColors.ControlDarkColorKey}">#FFEAF3FF</Color>

        <!-- Reusable label style -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,8,0,2"/>
        </Style>

        <!-- Input box style -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background"  Value="#12121E"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="Padding"     Value="8,5"/>
            <Setter Property="MinHeight"   Value="34"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DatePicker style -->
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="#12121E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- Aero template adds extra chrome + nested white borders; replace with flat layout. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal"/>
                                    <VisualState Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PART_DisabledVisual"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <Grid.Resources>
                                    <ControlTemplate x:Key="DropDownButtonTemplate" TargetType="Button">
                                        <Border x:Name="DropBd"
                                                Background="#333754"
                                                BorderBrush="#4A4A6A"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Width="30" Height="28"
                                                SnapsToDevicePixels="True">
                                            <!-- Simple calendar glyph -->
                                            <Path Stretch="Uniform"
                                                  Margin="7,6,7,6"
                                                  Fill="#EAF0FF"
                                                  Data="M4,2 L12,2 L12,3 L14,3 L14,2 L22,2 L22,3 L24,3 L24,12 L2,12 L2,3 L4,3 Z M6,6 L20,6 L20,10 L6,10 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DropBd" Property="Background" Value="#3D4261"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="DropBd" Property="Background" Value="#484F74"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="DropBd" Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Margin="0,0,8,0"
                                                   HorizontalContentAlignment="Stretch"
                                                   VerticalContentAlignment="Stretch"
                                                   Focusable="{TemplateBinding Focusable}"/>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Template="{StaticResource DropDownButtonTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Focusable="False"
                                        VerticalAlignment="Center"/>
                                <Grid x:Name="PART_DisabledVisual"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Opacity="0"
                                      IsHitTestVisible="False">
                                    <Rectangle RadiusX="4" RadiusY="4" Fill="#661E1E2E"/>
                                </Grid>
                                <Popup x:Name="PART_Popup"
                                       PlacementTarget="{Binding ElementName=PART_TextBox}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Path=(SystemParameters.HighContrast)}" Value="False">
                                <Setter TargetName="PART_TextBox" Property="Foreground"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <!-- CalendarItem template binds weekday labels to system keys; override them here. -->
                        <Style.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#F2F5FF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#D7DDF7"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}" Color="#4A4A6A"/>
                            <Color x:Key="{x:Static SystemColors.ActiveCaptionTextColorKey}">#FFFFFFFF</Color>
                            <Color x:Key="{x:Static SystemColors.ControlDarkColorKey}">#FFEAF3FF</Color>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#F5F7FF"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5A9DE3"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#6AA9EA"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                <TextBlock Text="{Binding}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#D9E0FF"
                                           Margin="0,6,0,4"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </Style.Resources>
                        <Setter Property="Background" Value="#2A2A3E"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#5B6288"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Calendar">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10"
                                            Padding="6">
                                        <CalendarItem x:Name="PART_CalendarItem"
                                                      Style="{TemplateBinding CalendarItemStyle}"
                                                      Background="Transparent"
                                                      BorderBrush="Transparent"
                                                      BorderThickness="0"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="CalendarItemStyle">
                            <Setter.Value>
                                <Style TargetType="CalendarItem">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CalendarItem">
                                                <Grid x:Name="Root">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button x:Name="PART_PreviousButton"
                                                            Grid.Row="0" Grid.Column="0"
                                                            Width="24" Height="22"
                                                            Margin="6,2,6,6"
                                                            Focusable="False"
                                                            Background="#4A5178"
                                                            BorderBrush="Transparent"
                                                            Foreground="White"
                                                            FontWeight="Bold"
                                                            Content="◀"/>

                                                    <Button x:Name="PART_HeaderButton"
                                                            Grid.Row="0" Grid.Column="1"
                                                            Margin="0,2,0,6"
                                                            Focusable="False"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            Foreground="#F5F7FF"
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Padding="8,0"/>

                                                    <Button x:Name="PART_NextButton"
                                                            Grid.Row="0" Grid.Column="2"
                                                            Width="24" Height="22"
                                                            Margin="6,2,6,6"
                                                            Focusable="False"
                                                            Background="#4A5178"
                                                            BorderBrush="Transparent"
                                                            Foreground="White"
                                                            FontWeight="Bold"
                                                            Content="▶"/>

                                                    <Grid x:Name="PART_MonthView"
                                                          Grid.Row="1" Grid.ColumnSpan="3"
                                                          Margin="4,0,4,4"
                                                          Visibility="Visible">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                    </Grid>

                                                    <Grid x:Name="PART_YearView"
                                                          Grid.Row="1" Grid.ColumnSpan="3"
                                                          Margin="4,0,4,4"
                                                          Visibility="Hidden">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                    </Grid>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger SourceName="PART_PreviousButton" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="PART_PreviousButton" Property="Background" Value="#5A9DE3"/>
                                                    </Trigger>
                                                    <Trigger SourceName="PART_NextButton" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="PART_NextButton" Property="Background" Value="#5A9DE3"/>
                                                    </Trigger>
                                                    <DataTrigger Value="Year">
                                                        <DataTrigger.Binding>
                                                            <Binding Path="DisplayMode">
                                                                <Binding.RelativeSource>
                                                                    <RelativeSource Mode="FindAncestor" AncestorType="{x:Type Calendar}" />
                                                                </Binding.RelativeSource>
                                                            </Binding>
                                                        </DataTrigger.Binding>
                                                        <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                                        <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Value="Decade">
                                                        <DataTrigger.Binding>
                                                            <Binding Path="DisplayMode">
                                                                <Binding.RelativeSource>
                                                                    <RelativeSource Mode="FindAncestor" AncestorType="{x:Type Calendar}" />
                                                                </Binding.RelativeSource>
                                                            </Binding>
                                                        </DataTrigger.Binding>
                                                        <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                                        <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="CalendarDayButtonStyle">
                            <Setter.Value>
                                <Style TargetType="CalendarDayButton">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="MinWidth" Value="28"/>
                                    <Setter Property="MinHeight" Value="26"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CalendarDayButton">
                                                <Border x:Name="DayBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="7"
                                                        Margin="1">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsInactive" Value="True">
                                            <Setter Property="Foreground" Value="#8187A8"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3F4565"/>
                                        </Trigger>
                                        <Trigger Property="IsToday" Value="True">
                                            <Setter Property="Background" Value="#31385B"/>
                                            <Setter Property="BorderBrush" Value="#88BFFF"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#5A9DE3"/>
                                            <Setter Property="BorderBrush" Value="#5A9DE3"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="CalendarButtonStyle">
                            <Setter.Value>
                                <Style TargetType="CalendarButton">
                                    <Setter Property="Foreground" Value="#EEF2FF"/>
                                    <Setter Property="Background" Value="#373C5A"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CalendarButton">
                                                <Border x:Name="MonthBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="7"
                                                        Margin="2"
                                                        Padding="6,3">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#444B6E"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#515A82"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default DatePickerTextBox template draws extra inner white borders; use one flat surface. -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>

        <!-- ComboBox style - Dark mode with proper display area -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#12121E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <!-- Default template paints the closed area with system chrome; override so Background applies. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ComboBoxToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False"/>
                                    <Path Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="{TemplateBinding Foreground}"
                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="#1A1A2E"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"/>
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7F89A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#5A6A8A"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#4A90D9"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter Property="BorderBrush" Value="#4A90D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Override default ComboBoxItem to have dark background when selected in display area -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border Name="Bd" 
                                Padding="{TemplateBinding Padding}" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3A5E"/>
                                <Setter Property="Foreground" Value="#7ABAFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#0A0A12"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Header style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2F3449"/>
            <Setter Property="Foreground" Value="#E8ECFF"/>
            <Setter Property="BorderBrush" Value="#4A4A6A"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid Cell style -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PassengersDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#1E2233"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5B6288"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3D435C"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PassengerGridTextBlock" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,8,0"/>
            <Setter Property="Padding" Value="0,2"/>
        </Style>

        <Style x:Key="PassengerGridTextBox" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ScrollViewer: app theme supplies ScrollBar chrome; keep panel backgrounds transparent -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL ═══════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="0" Margin="0,0,12,0" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

            <!-- App Title -->
            <TextBlock Text="🚂 IRCTC Tatkal Bot"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource AccentBlue}"
                       Margin="0,0,0,16"/>

            <!-- ── Accounts Section ── -->
            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="ACCOUNTS" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    <ListView x:Name="AccountsList"
                              ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                              SelectionMode="Single"
                              Background="Transparent" BorderThickness="0"
                              Height="140" Margin="0,6,0,8"
                              Foreground="White" FontSize="12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                    <TextBlock Text=" — " Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding Username}" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="+ Add Account"
                                Style="{StaticResource PrimaryBtn}"
                                Margin="0,0,8,0"
                                MinHeight="34" FontSize="12" Padding="12,8"
                                HorizontalAlignment="Stretch"
                                Click="AddAccountBtn_Click"/>
                        <Button Grid.Column="1"
                                Content="− Remove"
                                Style="{StaticResource DangerBtn}"
                                MinWidth="96" MinHeight="34" FontSize="12" Padding="12,8"
                                Command="{Binding RemoveAccountCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Train Config Section ── -->
            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="TRAIN CONFIG" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11"/>

                    <TextBlock Text="From Station" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding FromStation, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}"/>

                    <TextBlock Text="To Station" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding ToStation, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}"/>

                    <TextBlock Text="Journey Date" Style="{StaticResource Label}"/>
                    <DatePicker x:Name="JourneyDatePicker"
                                SelectedDate="{Binding JourneyDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedDateFormat="Short"
                                Style="{StaticResource DatePickerStyle}"
                                SelectedDateChanged="JourneyDatePicker_SelectedDateChanged"/>

                    <TextBlock Text="Train Number (optional)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding TrainNumber, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}"/>

                    <TextBlock Text="Class" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="ClassCombo"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding TrainClass, Mode=TwoWay}"
                              Style="{StaticResource ComboBoxStyle}">
                        <ComboBoxItem Content="SL"/>
                        <ComboBoxItem Content="3A" IsSelected="True"/>
                        <ComboBoxItem Content="2A"/>
                        <ComboBoxItem Content="1A"/>
                        <ComboBoxItem Content="CC"/>
                        <ComboBoxItem Content="2S"/>
                    </ComboBox>

                    <TextBlock Text="Passengers" Style="{StaticResource Label}"/>
                    <Border Background="#252A3F"
                            BorderBrush="#4A4A6A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="+ Add passenger" Style="{StaticResource PrimaryBtn}"
                                        Padding="12,8" Margin="0,0,8,0"
                                        FontSize="12" MinHeight="34"
                                        Command="{Binding AddPassengerCommand}"/>
                                <Button Content="− Remove" Style="{StaticResource DangerBtn}"
                                        Padding="12,8"
                                        FontSize="12" MinHeight="34"
                                        Command="{Binding RemovePassengerCommand}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding Passengers}"
                                      SelectedItem="{Binding SelectedPassenger, Mode=TwoWay}"
                                      Style="{StaticResource PassengersDataGrid}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      RowBackground="#1E2233"
                                      AlternatingRowBackground="#262B40"
                                      MinHeight="168"
                                      MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name"
                                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*" MinWidth="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PassengerGridTextBlock}"/>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource PassengerGridTextBox}"/>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Age"
                                                        Binding="{Binding Age, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="SizeToHeader"
                                                        MinWidth="52">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PassengerGridTextBlock}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource PassengerGridTextBox}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Gender"
                                                        Binding="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="SizeToHeader"
                                                        MinWidth="64">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PassengerGridTextBlock}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource PassengerGridTextBox}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Berth"
                                                        Binding="{Binding BerthPreference, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="SizeToHeader"
                                                        MinWidth="56">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PassengerGridTextBlock}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource PassengerGridTextBox}">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="ID #"
                                                        Binding="{Binding IdNumber, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="SizeToHeader"
                                                        MinWidth="72">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PassengerGridTextBlock}"/>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource PassengerGridTextBox}"/>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Label}">
                        <Run Text="UPI ID"/>
                        <Run Text=" (optional)" Foreground="{StaticResource TextMuted}" FontWeight="Normal"/>
                    </TextBlock>
                    <TextBlock Text="Leave blank to type your VPA on the payment page in Chrome."
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,-4,0,6" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding UpiId, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}" x:Name="UpiIdBox"
                             ToolTip="If empty, enter UPI manually in the browser when payment opens."/>
                </StackPanel>
            </Border>

            <!-- ── Settings Section ── -->
            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="SETTINGS" FontWeight="Bold" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    <TextBlock Text="Captcha provider" Style="{StaticResource Label}"/>
                    <ComboBox Style="{StaticResource ComboBoxStyle}"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding CaptchaProviderSetting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="2Captcha" Tag="2captcha"/>
                        <ComboBoxItem Content="Anti-Captcha" Tag="anticaptcha"/>
                        <ComboBoxItem Content="Manual (no API key)" Tag="manual"/>
                    </ComboBox>
                    <TextBlock Text="API key (2Captcha)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding CaptchaApiKey, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Input}"/>
                    <TextBlock Text="Anti-Captcha client key (optional)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding AntiCaptchaApiKey, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource Input}"/>
                    <CheckBox Content="Show Chrome windows"
                              IsChecked="{Binding ShowBrowserWindows}"
                              Foreground="#CCCCDD"
                              Margin="0,8,0,4"/>
                    <TextBlock Text="Chrome executable (optional)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding ChromeBinaryPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input}"
                             ToolTip="Full path to chrome.exe if Selenium cannot find Chrome (portable install, side-by-side versions). Leave empty for default."/>
                    <Button Content="Test Chrome driver"
                            Style="{StaticResource SecondaryBtn}"
                            Margin="0,8,0,4" Padding="12,8" HorizontalAlignment="Stretch"
                            Click="TestChromeBtn_Click"
                            ToolTip="Starts Chrome once and opens about:blank — verifies ChromeDriver only; does not open IRCTC."/>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ RIGHT PANEL ══════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="80"/>
                <RowDefinition Height="*" MinHeight="140"/>
            </Grid.RowDefinitions>

            <!-- ── Top Controls ── -->
            <Border Grid.Row="0" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13" Foreground="{StaticResource TextMuted}">
                            Tatkal window: <Run Foreground="{StaticResource AccentBlue}"
                                                Text="{Binding WindowTimeDisplay}"/>
                        </TextBlock>
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="White"
                                   Text="{Binding CountdownText}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="▶  Start (Scheduled)"
                            Style="{StaticResource PrimaryBtn}"
                            Margin="8,0" IsEnabled="{Binding CanStart}"
                            Click="StartScheduledBtn_Click"/>

                    <Button Grid.Column="2" Content="⚡ Start Now"
                            Style="{StaticResource PrimaryBtn}"
                            Background="#9B59B6" Margin="0,0,8,0"
                            IsEnabled="{Binding CanStart}"
                            Click="StartNowBtn_Click"/>

                    <Button Grid.Column="3" Content="⏹ Stop"
                            Style="{StaticResource DangerBtn}"
                            IsEnabled="{Binding IsRunning}"
                            Click="StopBtn_Click"/>
                </Grid>
            </Border>

            <!-- ── Results Table (Grid so DataGrid gets a real height cap; StackPanel was unbounded and broke layout/scroll) ── -->
            <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="BOOKING RESULTS"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Results}"
                              AutoGenerateColumns="False"
                              Background="#1A1A2E"
                              Foreground="White"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowBackground="#1A1A2E"
                              AlternatingRowBackground="#22223A"
                              BorderThickness="1"
                              BorderBrush="#4A4A6A"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="True"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account"   Binding="{Binding AccountId}" Width="100"/>
                            <DataGridTextColumn Header="Status"    Binding="{Binding Status}"    Width="100"/>
                            <DataGridTextColumn Header="PNR"       Binding="{Binding PnrNumber}" Width="100"/>
                            <DataGridTextColumn Header="Elapsed"   Binding="{Binding ElapsedSeconds, StringFormat={}{0:F1}s}" Width="72"/>
                            <DataGridTextColumn Header="Phases"    Binding="{Binding PhaseTimingSummary}" Width="220"/>
                            <DataGridTextColumn Header="Error"     Binding="{Binding ErrorMessage}" Width="*" MinWidth="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ── Live Log (row has MinHeight; ListBox uses pixel scroll so the vertical bar appears reliably) ── -->
            <Border Grid.Row="2" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="LIVE LOG"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy all"
                                    Style="{StaticResource SecondaryBtn}"
                                    FontSize="11" Padding="10,4" MinHeight="0"
                                    Margin="0,0,6,0"
                                    Click="CopyLogAll_Click"
                                    ToolTip="Copy entire log to clipboard (newest lines first)"/>
                            <Button Content="Copy line"
                                    Style="{StaticResource SecondaryBtn}"
                                    FontSize="11" Padding="10,4" MinHeight="0"
                                    Click="CopyLogLine_Click"
                                    ToolTip="Copy selected line (click a line first)"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="LiveLogList"
                             Grid.Row="1"
                             MinHeight="60"
                             VerticalAlignment="Stretch"
                             ItemsSource="{Binding Logs}"
                             Background="#1A1A2E"
                             BorderBrush="#4A4A6A"
                             BorderThickness="1"
                             Foreground="#AAFFAA"
                             FontFamily="Consolas"
                             FontSize="11"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ContextMenuOpening="LiveLogList_ContextMenuOpening"
                             PreviewKeyDown="LiveLogList_PreviewKeyDown">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel ScrollUnit="Pixel"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy line" Click="CopyLogLine_Click"/>
                                <MenuItem Header="Copy all" Click="CopyLogAll_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
