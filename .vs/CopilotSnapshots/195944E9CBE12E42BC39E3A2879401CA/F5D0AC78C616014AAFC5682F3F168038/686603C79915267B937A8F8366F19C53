<Window x:Class="IRCTCTatkalBot.Views.AddAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add IRCTC Account" Height="420" Width="400"
        Background="#1E1E2E" Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="20">
        <TextBlock Text="Add IRCTC Account" FontSize="16" FontWeight="Bold"
                   Foreground="#4A90D9" Margin="0,0,0,16"/>

        <TextBlock Text="Display Name" Foreground="#CCCCDD" Margin="0,0,0,4"/>
        <TextBox x:Name="DisplayNameBox" Height="30" Background="#12121E"
                 Foreground="White" BorderBrush="#4A4A6A" Padding="6,4" FontSize="13"/>

        <TextBlock Text="IRCTC Username" Foreground="#CCCCDD" Margin="0,12,0,4"/>
        <TextBox x:Name="UsernameBox" Height="30" Background="#12121E"
                 Foreground="White" BorderBrush="#4A4A6A" Padding="6,4" FontSize="13"/>

        <TextBlock Text="Password" Foreground="#CCCCDD" Margin="0,12,0,4"/>
        <PasswordBox x:Name="PasswordBox" Height="30" Background="#12121E"
                     Foreground="White" BorderBrush="#4A4A6A" Padding="6,4" FontSize="13"/>

        <TextBlock Text="Phone (for OTP)" Foreground="#CCCCDD" Margin="0,12,0,4"/>
        <TextBox x:Name="PhoneBox" Height="30" Background="#12121E"
                 Foreground="White" BorderBrush="#4A4A6A" Padding="6,4" FontSize="13"/>

        <TextBlock Text="Proxy (socks5://host:port, optional)" Foreground="#CCCCDD" Margin="0,12,0,4"/>
        <TextBox x:Name="ProxyBox" Height="30" Background="#12121E"
                 Foreground="White" BorderBrush="#4A4A6A" Padding="6,4" FontSize="13"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Width="90" Height="34" Margin="0,0,10,0"
                    Background="#444455" Foreground="White" BorderThickness="0"
                    Click="CancelBtn_Click"/>
            <Button Content="Add Account" Width="110" Height="34"
                    Background="#4A90D9" Foreground="White" BorderThickness="0"
                    FontWeight="Bold" Click="AddBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
